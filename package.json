{
  "name": "volley-pro",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "node scripts/dev.mjs && concurrently --kill-others-on-fail --names api,web \"npm run dev:api\" \"npm run dev:web\"",
    "dev:api": "node scripts/dev.mjs --api",
    "dev:web": "npm --prefix frontend run dev",
    "verificar": "node scripts/verificar.mjs",
    "teste:api": "composer --working-dir=backend test",
    "teste:web": "npm --prefix frontend run test -- --run",
    "docs:verificar": "node scripts/verificar-docs.mjs",
    "autoria:verificar": "node scripts/verificar-autoria.mjs"
  },
  "devDependencies": {
    "concurrently": "10.0.6"
  }
}
