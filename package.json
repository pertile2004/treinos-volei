{
  "name": "volley-pro",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "docker compose up -d && concurrently --kill-others-on-fail --names api,web \"php backend/artisan serve\" \"npm --prefix frontend run dev\"",
    "dev:web": "npm --prefix frontend run dev",
    "verificar": "node scripts/verificar.mjs",
    "teste:web": "npm --prefix frontend run test -- --run",
    "docs:verificar": "node scripts/verificar-docs.mjs",
    "autoria:verificar": "node scripts/verificar-autoria.mjs"
  },
  "devDependencies": {
    "concurrently": "10.0.6"
  }
}
