{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "permissions": {
    "allow": [
      "Bash(npm run *)",
      "Bash(npm --prefix frontend *)",
      "Bash(composer --working-dir=backend *)",
      "Bash(php backend/artisan *)",
      "Bash(node scripts/*)",
      "Bash(node .claude/hooks/*)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git switch *)",
      "Bash(git fetch *)",
      "Bash(git pull --ff-only *)",
      "Bash(git merge origin/main)",
      "Bash(git push -u origin feature/*)",
      "Bash(git push origin feature/*)",
      "Bash(git push)",
      "Bash(gh pr *)",
      "Bash(gh run *)",
      "Bash(docker compose *)",
      "PowerShell(npm run *)",
      "PowerShell(git status *)",
      "PowerShell(git add *)",
      "PowerShell(git commit *)",
      "PowerShell(gh pr *)",
      "PowerShell(npm --prefix frontend *)",
      "PowerShell(composer --working-dir=backend *)",
      "PowerShell(php backend/artisan *)",
      "PowerShell(node scripts/*)",
      "PowerShell(node .claude/hooks/*)",
      "PowerShell(git diff *)",
      "PowerShell(git log *)",
      "PowerShell(git switch *)",
      "PowerShell(git fetch *)",
      "PowerShell(git pull --ff-only *)",
      "PowerShell(git merge origin/main)",
      "PowerShell(git push -u origin feature/*)",
      "PowerShell(git push origin feature/*)",
      "PowerShell(git push)",
      "PowerShell(gh run *)",
      "PowerShell(docker compose *)"
    ],
    "deny": [
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push --force-with-lease *)",
      "Bash(git push * main)",
      "Bash(git reset --hard *)",
      "Bash(git clean *)",
      "Bash(git checkout .)",
      "Bash(git checkout -- *)",
      "Bash(git restore *)",
      "Bash(git rebase *)",
      "Bash(git branch -D *)",
      "Bash(git stash drop *)",
      "Bash(git stash clear *)",
      "Bash(git filter-branch *)",
      "Bash(rm -rf *)",
      "Bash(rm -fr *)",
      "Bash(rm -r *)",
      "Bash(php backend/artisan migrate:fresh *)",
      "Bash(php backend/artisan migrate:reset *)",
      "Bash(php backend/artisan migrate:refresh *)",
      "Bash(php backend/artisan db:wipe *)",
      "Bash(php artisan migrate:fresh *)",
      "Bash(php artisan migrate:reset *)",
      "Bash(php artisan migrate:refresh *)",
      "Bash(php artisan db:wipe *)",
      "Bash(docker compose down -v *)",
      "Bash(docker volume rm *)",
      "Bash(docker system prune *)",
      "Bash(gh repo delete *)",
      "PowerShell(git push --force *)",
      "PowerShell(git push -f *)",
      "PowerShell(git reset --hard *)",
      "PowerShell(git clean *)",
      "PowerShell(git checkout -- *)",
      "PowerShell(git rebase *)",
      "PowerShell(Remove-Item -Recurse *)",
      "PowerShell(Remove-Item * -Recurse *)",
      "PowerShell(git push --force-with-lease *)",
      "PowerShell(git push * main)",
      "PowerShell(git checkout .)",
      "PowerShell(git restore *)",
      "PowerShell(git stash drop *)",
      "PowerShell(git stash clear *)",
      "PowerShell(git filter-branch *)",
      "PowerShell(php backend/artisan migrate:fresh *)",
      "PowerShell(php backend/artisan migrate:reset *)",
      "PowerShell(php backend/artisan migrate:refresh *)",
      "PowerShell(php backend/artisan db:wipe *)",
      "PowerShell(php artisan migrate:fresh *)",
      "PowerShell(php artisan migrate:reset *)",
      "PowerShell(php artisan migrate:refresh *)",
      "PowerShell(php artisan db:wipe *)",
      "PowerShell(docker compose down -v *)",
      "PowerShell(docker volume rm *)",
      "PowerShell(docker system prune *)",
      "PowerShell(gh repo delete *)",
      "Read(**/.env)",
      "Read(**/.env.production)"
    ]
  },
  "hooks": {
    "SessionStart": [
      { "hooks": [ { "type": "command", "command": "node", "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/contexto-da-sessao.mjs"] } ] }
    ],
    "PreToolUse": [
      { "matcher": "Bash|PowerShell", "hooks": [ { "type": "command", "command": "node", "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/guarda-comandos.mjs"], "onFailure": "block" } ] }
    ],
    "PostToolUse": [
      { "matcher": "Edit|Write", "hooks": [ { "type": "command", "command": "node", "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/formatar.mjs"] } ] }
    ]
  }
}
