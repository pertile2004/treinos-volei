APP_NAME="VOLLEY PRO"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
APP_VERSAO=0.1.0

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR
APP_TIMEZONE=UTC

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=volleypro
DB_USERNAME=volleypro
DB_PASSWORD=volleypro

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# false só no desenvolvimento local em http; em produção (HTTPS) use true.
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

FRONTEND_URL=http://localhost:5173
SANCTUM_STATEFUL_DOMAINS=localhost:5173

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="nao-responda@volleypro.test"
MAIL_FROM_NAME="${APP_NAME}"

# Laravel Pulse (painel /pulse, so admin). PULSE_ENABLED=false desliga a coleta;
# as tabelas pulse_* guardam 7 dias (PULSE_STORAGE_KEEP).
PULSE_ENABLED=true
PULSE_PATH=pulse

# Canal da linha de log por requisicao (metricas de latencia e erros por rota).
# Padrao: arquivo diario storage/logs/requisicoes.log em JSON; em producao use stderr.
LOG_REQUISICOES_CHANNEL=requisicoes
