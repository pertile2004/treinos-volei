includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    level: 6
    paths:
        - app
        - bootstrap/app.php
        - config
        - database
        - routes
    excludePaths:
        # Migration publicada pelo laravel/pulse, mantida como veio do pacote.
        - database/migrations/*_create_pulse_tables.php
